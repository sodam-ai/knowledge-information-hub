# Supabase (필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 URL (로컬: http://localhost:3000 / 배포: 실제 도메인)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 열람 비밀번호 — 숫자 4자리 (/admin 페이지에서 변경 가능)
VIEW_PASSWORD=1234

# 관리자 비밀번호 — /admin 페이지 접근 및 열람 비밀번호 변경에 사용 (/admin에서 변경 가능)
ADMIN_PASSWORD=

# 세션 서명 시크릿 — 절대 외부 노출 금지 (openssl rand -hex 32 으로 생성)
SESSION_SECRET=

# Upstash Redis — Rate Limiting (권장, 없으면 fail-open)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Microlink.io — URL 제목 자동 추출 (선택, 없으면 URL을 제목으로 사용)
MICROLINK_API_KEY=
