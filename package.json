{
  "name": "knowledge-information-hub",
  "version": "1.1.2",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:local": "node scripts/build-local.mjs",
    "migrate:from-supabase": "node --env-file=.env.local scripts/migrate-from-supabase.mjs export",
    "migrate:import": "node scripts/migrate-from-supabase.mjs import",
    "electron:dev": "electron electron/main.cjs",
    "dist": "npm run build:local && electron-builder",
    "dist:win": "npm run build:local && electron-builder --win",
    "dist:mac": "npm run build:local && electron-builder --mac",
    "dist:linux": "npm run build:local && electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "env-paths": "^3.0.0",
    "lucide-react": "^0.503.0",
    "next": "15.5.15",
    "open": "^10.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "png-to-ico": "^3.0.1",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
